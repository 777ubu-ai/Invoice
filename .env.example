# Invoice Bot uses the existing Invoice bot account shown by the owner.
# Packing Bot uses a newly created, separate BotFather account.
# Two different tokens. Never commit real tokens.
PACKING_BOT_TOKEN=
INVOICE_BOT_TOKEN=
# Use a new development database. No access to legacy tables is needed.
DATABASE_URL=postgresql://packing_invoice:change-me@localhost:5432/packing_invoice
# Comma-separated numeric Telegram user IDs. These users can access both bots.
OWNER_TELEGRAM_IDS=
