# ===========================================================================
# TNVED.ai bot — environment variables. Copy this file to `.env` and fill in.
# NEVER commit the real .env to git.
# ===========================================================================

# --- Telegram --------------------------------------------------------------
# From @BotFather. The bot's identity — do not share.
TELEGRAM_BOT_TOKEN=1234567890:AA...

# Your own Telegram user id (numeric). Bot promotes this account to OWNER on
# first startup. Get it from @userinfobot.
INITIAL_OWNER_TG_USER_ID=123456789

# Telegram API credentials for the LOCAL Bot API server we run in-container.
# The local server supports large files, but production policy below keeps a
# smaller limit so uploads cannot fill the VPS disk.
# Get them at https://my.telegram.org → App configuration.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Max accepted Telegram file size. Default is 100 MB. Keep this well below the
# local Bot API 2 GB transport limit unless the VPS has dedicated disk headroom.
MAX_TELEGRAM_FILE_BYTES=104857600

# --- Anthropic (Claude API) ------------------------------------------------
# From console.anthropic.com/settings/keys.  Separate from any Pro/Max
# subscription — this key charges your API balance directly.
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Postgres --------------------------------------------------------------
# Database credentials. Password protects operator + invoice data.
POSTGRES_USER=tnved
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=tnved

# --- PostgREST (Supabase compat layer) -------------------------------------
# Random 32+ char string. Used to sign the bot's bearer token.  Generate with:
#   openssl rand -base64 48
SUPABASE_JWT_SECRET=CHANGE_ME_TO_A_32PLUS_CHAR_RANDOM_STRING

# JWT that grants the bot service-role access. Generated once via:
#   ./scripts/gen-service-role-jwt.sh
# See MIGRATION.md step 4.
SUPABASE_SERVICE_KEY=eyJ...

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
